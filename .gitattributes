# Default: plain LF text (docs, templates, engine, commands).
# Order matters: in .gitattributes the LAST matching line wins, so the general rule
# goes first and the package exceptions below override it.
* text=auto eol=lf
*.png binary

# windows/ and macos/ are the published StereoVibe Lite packages, byte-for-byte.
# Their line endings and BOMs are load-bearing (.cmd = ASCII+CRLF, .ps1 = UTF-8 BOM+CRLF,
# macOS .sh/.command = LF, a CR in the shebang kills them with "bad interpreter").
# Store them exactly as they are, whatever core.autocrlf says on the cloning machine.
windows/** -text
macos/**   -text
