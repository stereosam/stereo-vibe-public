#!/bin/bash
# STEREO Vibe Lite для macOS — то, на что нажимают.
# Двойной клик в Finder открывает этот файл в Терминале.
#   Запустить Vibe.command                — проверить и поставить недостающее
#   Запустить Vibe.command --check        — только проверка, ничего не ставим
#   Запустить Vibe.command --no-report    — не отправлять обезличенную сводку
# Служебная папка ищется по лежащему в ней скрипту, а не по имени:
# переименование папки ничего не ломает.
# Скрипт всегда запускается штатным /bin/bash, а не тем, что первым в PATH.
DIR="$(cd "$(dirname "$0")" && pwd)"
CORE=''
for d in "$DIR"/*/; do
  if [ -f "${d}check-work-tools.sh" ]; then CORE="${d%/}"; break; fi
done
if [ -z "$CORE" ]; then
  echo ''
  echo '  Не нахожу служебную папку пакета.'
  echo ''
  echo '  Сначала распакуй архив: двойной клик по stereovibe-lite-mac.zip,'
  echo '  потом открой распакованную папку и запусти «Запустить Vibe.command» оттуда.'
  echo ''
  echo '  Если архив уже распакован: папка «_не трогать» должна лежать рядом с этим файлом.'
  echo '  Удалил или перенёс её — скачай архив заново.'
  echo ''
  if [ -t 0 ]; then read -r -p '  Нажми Enter, чтобы закончить. ' _; fi
  exit 3
fi
exec /bin/bash "$CORE/check-work-tools.sh" "$@"
